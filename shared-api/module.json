{
  "$schema": "https://raw.githubusercontent.com/fabian20ro/shared-api-contract/v2.0.0/schema/module.schema.json",
  "schemaVersion": 2,
  "id": "propozitii",
  "contractVersion": 2,
  "runtime": {
    "abi": "web-fetch-v1",
    "profiles": ["node-24", "web-worker"],
    "capabilities": ["outbound-fetch", "abort-signal"]
  },
  "build": {
    "entry": "src/index.ts",
    "export": "createHandler",
    "output": "dist/index.js"
  },
  "routes": [
    {
      "path": "/api/all",
      "methods": ["GET", "OPTIONS"],
      "response": "json"
    }
  ],
  "config": [
    { "name": "SUPABASE_URL", "type": "string", "required": true, "sensitive": false },
    { "name": "SUPABASE_PUBLISHABLE_KEY", "type": "string", "required": true, "sensitive": true },
    { "name": "ALLOWED_ORIGINS", "type": "string[]", "required": true, "sensitive": false },
    { "name": "GENERATOR_TIMEOUT_MS", "type": "integer", "required": false, "sensitive": false }
  ],
  "dependencies": [
    { "id": "supabase", "kind": "database-api" }
  ],
  "contracts": {
    "fixtureDirectory": "test/fixtures"
  }
}
